# Fabric Eventstream connection strings - Day 2 setup.
#
# Copy this file to fabric/.fabric.env (gitignored) and fill in the
# connection strings as you create each Eventstream's Custom Endpoint
# (protocol: Event Hub) in the Fabric portal. Then load it into your
# PowerShell session with:
#
#   . .\fabric\load_fabric_env.ps1
#
# Only wire RAW telemetry streams. Enrichment and forecasting happen
# natively inside Fabric via KQL (see fabric/kql/phase2_enrichment.kql and
# fabric/kql/phase3_native_scoring.kql) -- leave FABRIC_ES_PREDICTIONS and
# FABRIC_ES_ACTIVATOR_ALERTS blank; those are not wired at all, Fabric
# Activator computes and detects them itself from the raw streams below.

FABRIC_ES_GENERATION_TELEMETRY=
FABRIC_ES_GRID_TELEMETRY=
FABRIC_ES_METER_TELEMETRY=
FABRIC_ES_WEATHER_OBSERVATIONS=
FABRIC_ES_CRM_CONTEXT=
FABRIC_ES_ERP_ASSETS=

# Intentionally left blank -- do not wire these (see note above):
FABRIC_ES_PREDICTIONS=
FABRIC_ES_ACTIVATOR_ALERTS=
